{
  "name": "Nim Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "nimsaem.nimvscode",    // Nim extension
    "ms-vscode.cpptools",  // C/C++ (dibutuhkan Nim karena compile ke C)
    "editorconfig.editorconfig",
    "eamodio.gitlens"
  ],
  "remoteEnv": {
    "PATH": "/home/vscode/.nimble/bin:${PATH}",
    "NIMBLE_DIR": "/home/vscode/.nimble"
  },
  "postCreateCommand": "nim --version && nimble --version",
  "remoteUser": "vscode"
}
